{
  "name": "wa5",
  "productName": "WA5",
  "version": "1.4.4",
  "description": "Up to five WhatsApp Web accounts at once, each in its own isolated session. macOS, Windows and Linux, Electron.",
  "main": "main.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waltgarcia/wa5.git"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "multi-cuenta",
    "electron",
    "macos",
    "windows",
    "linux",
    "multi-account"
  ],
  "scripts": {
    "start": "electron .",
    "build": "npm run build:mac",
    "build:mac": "electron-packager . WA5 --platform=darwin --arch=arm64 --overwrite --out=dist --app-bundle-id=io.github.wa5 --icon=assets/icon.icns --ignore=^/dist --ignore=^/docs --ignore=^/.github --ignore=^/mcp",
    "build:mac:intel": "electron-packager . WA5 --platform=darwin --arch=x64 --overwrite --out=dist --app-bundle-id=io.github.wa5 --icon=assets/icon.icns --ignore=^/dist --ignore=^/docs --ignore=^/.github --ignore=^/mcp",
    "build:win": "electron-packager . WA5 --platform=win32 --arch=x64 --overwrite --out=dist --app-bundle-id=io.github.wa5 --icon=assets/icon.ico --ignore=^/dist --ignore=^/docs --ignore=^/.github --ignore=^/mcp",
    "build:linux": "electron-packager . WA5 --platform=linux --arch=x64 --overwrite --out=dist --ignore=^/dist --ignore=^/docs --ignore=^/.github --ignore=^/mcp",
    "mcp": "node mcp/servidor.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron": "^45.2.1",
    "zod": "^4.6.7"
  }
}
