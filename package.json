{
  "name": "wa5",
  "productName": "WA5",
  "version": "1.4.0",
  "description": "Up to five WhatsApp Web accounts at once, each in its own isolated session. macOS, Electron.",
  "main": "main.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waltgarcia/wa5.git"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "multi-cuenta",
    "electron",
    "macos",
    "multi-account"
  ],
  "scripts": {
    "start": "electron .",
    "build": "electron-packager . WA5 --platform=darwin --overwrite --out=dist --app-bundle-id=io.github.wa5 --icon=assets/icon.icns --ignore=\"^/(dist|docs|\\.github|mcp)\"",
    "mcp": "node mcp/servidor.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron": "^45.2.1",
    "zod": "^4.6.7"
  }
}
