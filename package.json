{
  "name": "wa5",
  "productName": "WA5",
  "version": "1.3.1",
  "description": "Hasta cinco cuentas de WhatsApp Web al mismo tiempo, cada una con su sesión aislada",
  "main": "main.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waltgarcia/wa5.git"
  },
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "multi-cuenta",
    "electron",
    "macos",
    "multi-account"
  ],
  "scripts": {
    "start": "electron .",
    "empaquetar": "electron-packager . WA5 --platform=darwin --overwrite --out=dist --app-bundle-id=io.github.wa5 --app-version=1.0.1 --icon=assets/icon.icns --ignore=\"^/(dist|docs|\\.github|mcp)\"",
    "postinstall": "echo 'Listo. Corre: npm start'",
    "mcp": "node mcp/servidor.mjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "electron": "^45.2.1",
    "zod": "^4.6.7"
  }
}
